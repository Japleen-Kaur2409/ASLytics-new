{
  "name": "aslytics-extension",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "node copy-ort.mjs && tsc --noEmit && vite build && vite build --config vite.background.config.ts",
    "dev": "node copy-ort.mjs && vite --port 5178",
    "test": "vitest run",
    "preview": "vite preview --port 5179 --strictPort"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.280",
    "@types/three": "^0.170.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
